generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String?
  liveLink      String?
  repoLink      String?
  downloadLink  String?
  iconUrl       String?
  viewsProject  Int      @default(0)
  viewsGithub   Int      @default(0)
  viewsLive     Int      @default(0)
  viewsDownload Int      @default(0)
  listing       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          ProjectTag[]
  contributors  ProjectContributor[]
  images        ProjectImage[]
  linkStats     LinkProjectStat[]
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  url       String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  color    String
  iconUrl  String?
  projects ProjectTag[]
}

model ProjectTag {
  projectId Int
  tagId     Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Contributor {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  imageUrl  String?
  github    String?
  linkedin  String?
  facebook  String?
  instagram String?
  portfolio String?
  projects  ProjectContributor[]
}

model ProjectContributor {
  projectId     Int
  contributorId Int
  roleAtProject String?
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([projectId, contributorId])
}

model TechStackItem {
  id        Int    @id @default(autoincrement())
  name      String
  iconUrl   String
  sortOrder Int    @default(0)
}

model HandlingProject {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      String
}

model SocialLink {
  id       Int    @id @default(autoincrement())
  platform String
  url      String
}

model EducationEntry {
  id          Int    @id @default(autoincrement())
  degree      String
  institution String
  period      String?
  sortOrder   Int    @default(0)
}

model ImpactEntry {
  id        Int    @id @default(autoincrement())
  text      String
  sortOrder Int    @default(0)
}

model LanguageEntry {
  id        Int    @id @default(autoincrement())
  name      String
  level     String
  sortOrder Int    @default(0)
}

model SettingsAccount {
  id           Int     @id @default(1)
  name         String?
  title        String?
  heroImageUrl String?
  imageUrl     String?
  bio          String?
  email        String?
  phone        String?
  location     String?
}

model SettingsAvailability {
  id                  Int   @id @default(1)
  availabilityPercent Int   @default(0)
  timezoneOffset      Float @default(0)
}

model AnalyticsSummary {
  id                Int @id @default(1)
  totalReach        Int @default(0)
  reachPerDevice    Int @default(0)
  totalProjectViews Int @default(0)
  totalSocialClicks Int @default(0)
}

model AnalyticsDaily {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique @db.Date
  total        Int      @default(0)
  unique       Int      @default(0)
  projectViews Int      @default(0)
  socialClicks Int      @default(0)
}

model TrackingLink {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  name                String
  forField            String
  interviewer         Boolean  @default(false)
  views               Int      @default(0)
  totalSessionSeconds Int      @default(0)
  stackSeconds        Int      @default(0)
  contactOpens        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  projectStats        LinkProjectStat[]
  socialStats         LinkSocialStat[]
}

model LinkProjectStat {
  id        Int          @id @default(autoincrement())
  linkId    Int
  projectId Int
  seconds   Int          @default(0)
  views     Int          @default(0)
  link      TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([linkId, projectId])
}

model LinkSocialStat {
  id       Int          @id @default(autoincrement())
  linkId   Int
  platform String
  seconds  Int          @default(0)
  views    Int          @default(0)
  link     TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, platform])
}

model Meeting {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  time          String
  name          String
  email         String
  reason        String?
  meetingLink   String?
  googleEventId String?
  userTimezone  Float?
  userLocalTime String?
  createdAt     DateTime @default(now())

  @@unique([date, time])
  @@index([date])
}

model ContactMessage {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  message       String
  number        String?
  whatsapp      Boolean  @default(false)
  filesAttached String?  @db.NVarChar(Max)
  createdAt     DateTime @default(now())
}

model SocialClick {
  id              Int      @id @default(autoincrement())
  platform        String
  clickedAt       DateTime @default(now())
  durationSeconds Float?
}
